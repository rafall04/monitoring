// =============================================================================
// MikroTik NOC - data model
// Hierarchy: Company -> Site -> RouterMikrotik -> Device (host watched by Netwatch)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  sites Site[]

  @@map("company")
}

model Site {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name              String
  region            String? // kabupaten / regency — groups factories in the global overview
  mapMode           String  @default("geo") // geo | floorplan
  floorplanImageUrl String?
  floorplanWidth    Int?
  floorplanHeight   Int?
  imageBounds       Json? // [[y0,x0],[y1,x1]] for CRS.Simple
  geoCenterLat      Float?
  geoCenterLng      Float?
  defaultZoom       Int     @default(13)

  telegramMode         String  @default("off") // off | server | router
  telegramChatId       String?
  telegramBotEncrypted String? // AES-256-GCM bot token, never exposed to clients

  // WhatsApp alerting (apps/wabot, Baileys). "server" = the wabot process sends
  // alerts to this site's recipients (numbers AND groups — see WaRecipient).
  // There is no "router" mode — RouterOS cannot run a WhatsApp client.
  whatsappMode String @default("off") // off | server

  createdAt DateTime @default(now())

  routers     RouterMikrotik[]
  areas       Area[]
  devices     Device[]
  waRecipients WaRecipient[]
  tickets     Ticket[]

  @@index([companyId])
  @@map("site")
}

// An organizational zone within a factory: either a set of production Lines
// (kind="lines", e.g. Assembly) or a flat room (kind="room", e.g. QC, Server).
model Area {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name       String
  kind       String   @default("lines") // lines | room
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  lines   Line[]
  devices Device[]

  @@index([siteId])
  @@map("area")
}

// An ordered production line inside an Area (Line A, Line B, …).
model Line {
  id         String   @id @default(cuid())
  areaId     String
  area       Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  devices Device[]

  @@index([areaId])
  @@map("line")
}

model RouterMikrotik {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  name              String
  host              String
  apiPort           Int      @default(8728)
  useTls            Boolean  @default(false)
  username          String
  passwordEncrypted String // AES-256-GCM, never exposed to clients
  routerosVersion   String   @default("v6") // v6 | v7
  pollIntervalSec   Int?
  webhookToken      String   @unique
  status            String   @default("unknown") // online | offline | unknown
  lastSeenAt        DateTime?
  resourceCache     Json?
  // Firewall drift watch: the worker snapshots nat/filter/mangle each poll
  // and alerts on any change (incl. manual disable — the 18:39 NAT incident).
  watchConfig       Boolean  @default(true)

  createdAt DateTime @default(now())

  devices Device[]
  members AppUser[] // member-role users whose hotspot account lives on this router

  @@index([siteId])
  @@map("router_mikrotik")
}

model Device {
  id       String         @id @default(cuid())
  routerId String
  router   RouterMikrotik @relation(fields: [routerId], references: [id], onDelete: Cascade)
  siteId   String
  site     Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  areaId   String?
  area     Area?          @relation(fields: [areaId], references: [id], onDelete: SetNull)
  lineId   String?
  line     Line?          @relation(fields: [lineId], references: [id], onDelete: SetNull)

  name           String
  ipAddress      String?
  type           String   @default("other")
  iconKey        String? // key into built-in icon library
  iconUrl        String? // custom uploaded icon
  geoLat         Float? // geo maps
  geoLng         Float?
  mapX           Float? // floorplan maps (CRS.Simple units)
  mapY           Float?
  status         String   @default("unknown") // up | down | unknown
  statusSince    DateTime?
  manualOverride String? // null | maintenance
  netwatchSynced Boolean  @default(false)
  isCritical     Boolean  @default(false)
  orderIndex     Int      @default(0) // position within its line/room
  note           String?

  // Incident workflow: an acknowledged incident is "seen, working on it" (still
  // counts as down). A silenced device suppresses alerts until `silencedUntil`,
  // e.g. while a tech is on-site fixing things.
  ackBy          String?
  ackAt          DateTime?
  silencedUntil  DateTime?

  // Interface watch (uplink alarm): non-netwatch device whose status is driven
  // by a RouterOS interface's running flag — e.g. "ether2 = jalur ke 001".
  // watchInterface = interface name on `router`; watchAlertWindow = optional
  // per-device AlertWindow JSON overriding the global uplinkAlert* settings.
  watchInterface   String?
  // TCP port watch: status = TCP connect from the NOC server to
  // ipAddress:watchPort — catches "host up, service dead" (e.g. a killed
  // dst-nat forward) that ICMP Netwatch can never see. Probe-only devices are
  // excluded from Netwatch status reconciliation (their probe owns the verdict).
  watchPort        Int?
  watchAlertWindow Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents StatusEvent[]

  @@index([siteId])
  @@index([routerId])
  // One row per watched host per router: status is resolved by
  // routerId+ipAddress, so duplicates would race which row gets the update.
  // Postgres still allows multiple rows with ipAddress = NULL.
  @@unique([routerId, ipAddress])
  @@index([siteId, status])
  @@index([lineId])
  @@index([areaId])
  @@map("device")
}

model StatusEvent {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  oldStatus  String
  newStatus  String
  source     String // webhook | polling | manual
  occurredAt DateTime @default(now())

  @@index([deviceId, occurredAt])
  // Retention sweep purges by `occurredAt < cutoff` — without this it seq-scans.
  @@index([occurredAt])
  @@map("status_event")
}

model AppUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique // doubles as the login id — members log in with their hotspot username
  passwordHash String
  role         String   @default("viewer") // viewer | operator | super_admin | member
  scopeSiteIds Json     @default("[]")
  // member role: the hotspot account (router + username) this user self-manages
  // via /me/hotspot. Null for staff roles.
  hotspotRouterId  String?
  hotspotRouter    RouterMikrotik? @relation(fields: [hotspotRouterId], references: [id], onDelete: SetNull)
  hotspotUsername  String?
  // WhatsApp identity: E.164 digits without '+' (e.g. 62812xxx). The bot only
  // serves account commands to numbers that have passed verification.
  phone           String?
  phoneVerifiedAt DateTime?
  // Org unit shown on complaint tickets (free text). Set by admin or filled
  // once by the member themselves (bot asks once then saves it here).
  department  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  tickets       Ticket[]

  @@index([hotspotRouterId, hotspotUsername])
  @@map("app_user")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // sha256 of the opaque refresh token
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  // Retention sweep purges expired tokens by `expiresAt < now`.
  @@index([expiresAt])
  @@map("refresh_token")
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  user     AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action   String
  entity   String
  entityId String?
  before   Json?
  after    Json?
  ip       String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_log")
}

// Global NOC configuration. Single row (id = "global"). Includes white-label
// branding (org name, logo, accent color, default theme) and operational
// defaults (poll interval, retention, default map view).
model Setting {
  id                 String   @id @default("global")
  orgName            String   @default("RAF NOC")
  logoUrl            String?
  // RGB channel triplet e.g. "59 130 246" — consumed via CSS var --accent so
  // alpha utilities (bg-accent/20) keep working.
  accentRgb          String   @default("59 130 246")
  themeDefault       String   @default("dark") // dark | light
  defaultMapLat      Float    @default(-6.2)
  defaultMapLng      Float    @default(106.8)
  defaultMapZoom     Int      @default(13)
  defaultPollSec     Int      @default(20)
  eventRetentionDays Int      @default(90)
  auditRetentionDays Int      @default(180)

  // Netwatch defaults pushed onto routers by add-device + sync.
  netwatchIntervalSec  Int  @default(10)
  netwatchTimeoutMs    Int  @default(1000)
  // Free-form RouterOS code appended AFTER the NOC webhook fetch. Optional —
  // for LED triggers, logging, extra fetches, etc. The webhook itself is
  // always generated by NOC so monitoring never breaks.
  netwatchExtraUp      String?
  netwatchExtraDown    String?

  // Telegram alert templates with placeholders: {device} {ip} {site} {status}
  // {when}. Used by BOTH server-mode notify and router-mode Netwatch script.
  telegramDownTemplate String @default("🔴 DOWN — {device} ({ip})\n🏭 {site}")
  telegramUpTemplate   String @default("🟢 RECOVERED — {device} ({ip})\n🏭 {site}")

  // WhatsApp bot (apps/wabot). Templates share the Telegram placeholders.
  waDownTemplate      String  @default("🔴 *DOWN* — {device} ({ip})\n🏭 {site}\n🕐 {when}")
  waUpTemplate        String  @default("🟢 *RECOVERED* — {device} ({ip})\n🏭 {site}\n🕐 {when}")
  waBotName           String  @default("NOC Bot")
  waComplaintEnabled  Boolean @default(true) // accept complaints from unknown numbers
  waTicketEscalateMin Int     @default(30)   // open ticket age that pings managers

  // Global alert window for interface-watch ("uplink") devices — alerts fire
  // only inside this window; status still tracks 24/7. Minutes after midnight,
  // days = ISO weekday numbers (1=Mon..7=Sun). A device may override via its
  // own watchAlertWindow.
  uplinkAlertStartMin Int   @default(360)  // 06:00
  uplinkAlertEndMin   Int   @default(1080) // 18:00
  uplinkAlertDays     Int[] @default([1, 2, 3, 4, 5, 6, 7])

  updatedAt          DateTime @updatedAt

  @@map("setting")
}

// =============================================================================
// WhatsApp bot (apps/wabot). See docs/whatsapp-bot-plan.md.
// =============================================================================

// A site's WhatsApp alert/ticket recipients. Deliberately decoupled from
// AppUser: field technicians often have no NOC login — a phone number is the
// whole identity. `alerts`/`tickets` choose which traffic they receive.
// Unified WhatsApp recipient list per site. A row is either a personal number
// (kind='number', target='628xxx') or a WhatsApp group (kind='group',
// target='xxx@g.us'); each carries its own alert/ticket subscription flags so
// routing is fully mix-and-match from the admin WhatsApp page.
model WaRecipient {
  id       String  @id @default(cuid())
  siteId   String
  site     Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name     String
  kind     String  @default("number") // number | group
  target   String // phone digits (628xxx) or group JID (xxx@g.us)
  role     String  @default("technician") // technician | manager | noc
  alerts   Boolean @default(true)
  tickets  Boolean @default(true)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([siteId])
  @@map("wa_recipient")
}

// A user complaint raised over WhatsApp and forwarded to the site's contacts.
// memberId is set when the reporter's number is a verified AppUser phone —
// the ticket then carries the member context (site/username) automatically.
model Ticket {
  id            String    @id @default(cuid())
  siteId        String
  site          Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  memberId      String?
  member        AppUser?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  // Null for web-created complaints from members without a linked WA number —
  // reporter status updates then live only in the member's ticket history.
  reporterPhone String?
  reporterName  String?
  // Snapshot of the reporter's department at complaint time (free text).
  reporterDept  String?
  category      String    @default("gangguan") // gangguan | lambat | voucher | lainnya
  message       String
  status        String    @default("open") // open | ack | resolved
  handledBy     String? // technician name / AppUser that PROSES/SELESAI'd it
  escalatedAt   DateTime? // set when the worker pinged managers (once per ticket)
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([siteId, status])
  @@index([createdAt])
  @@map("ticket")
}

// Baileys auth state, one row per key (creds + signal-protocol keys), stored
// AES-256-GCM encrypted so container rebuilds never require re-pairing and
// session keys never sit on a volume in plaintext.
model WaAuthKey {
  key       String   @id
  valueEnc  String
  updatedAt DateTime @updatedAt

  @@map("wa_auth_key")
}

// Outbound message log. Producers (status engine, ticket forwards, admin test
// sends) INSERT a row + LPUSH the outbox; wabot BLPOPs, sends, and updates the
// status so every outbound message is auditable and retries are visible.
model WaMessage {
  id        String   @id @default(cuid())
  to        String // phone digits or group JID
  kind      String // alert | ticket-forward | reply | broadcast | test
  body      String
  status    String   @default("queued") // queued | sent | failed | dead
  siteId    String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@map("wa_message")
}

// =============================================================================
// Ruijie / Reyee Cloud integration (separate from the MikroTik spine).
// A cloud ACCOUNT (one app_id/secret) exposes many devices; the worker polls it
// READ-ONLY for per-router online status + connected-client counts. Different
// vendor/ecosystem from RouterMikrotik (no Netwatch/webhook/binary-API), so it
// gets its own models rather than overloading RouterMikrotik.
// =============================================================================
model RuijieAccount {
  id                 String    @id @default(cuid())
  label              String    @default("Ruijie Cloud")
  appId              String
  appSecretEncrypted String // AES-256-GCM, never exposed to clients
  baseUrl            String    @default("https://cloud-as.ruijienetworks.com")
  pollIntervalSec    Int? // null = use the default
  // Ruijie group_ids the NOC monitors. The account is the owner's PERSONAL one and
  // mixes many sites; the poller only stores devices in these groups (e.g. the
  // school), so non-NOC sites never reach our DB/UI. Empty = monitor nothing.
  monitoredGroupIds  String[]  @default([])
  // Map of Ruijie project (groupName) -> NOC siteId, so the Site page can
  // surface that project's AP + connected-client counts. {} = none mapped.
  groupSiteMap       Json      @default("{}")
  lastPolledAt       DateTime?
  lastError          String? // last poll failure message, for the admin UI
  createdAt          DateTime  @default(now())

  routers RuijieRouter[]

  @@map("ruijie_account")
}

model RuijieRouter {
  id        String        @id @default(cuid())
  accountId String
  account   RuijieAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  cloudSerial   String // serialNumber in Ruijie Cloud (stable id)
  cloudGroupId  String // BUILDING group_id — used for the on-demand client drill-down
  groupName     String // project/room name, for grouping in the UI
  name          String // aliasName
  model         String? // productClass, e.g. EW1300G
  online        Boolean   @default(false)
  clientCount   Int       @default(0) // staNums
  activeClients Int       @default(0) // staActiveNums
  localIp       String?
  wanIp         String?
  mac           String?
  firmware      String?
  // Free extras carried in the same fleet payload as the counts above (0 extra
  // API calls): per-radio channel utilization (WiFi congestion %, the "WiFi
  // lambat" companion signal to wired-port degradation) + a firmware-outdated
  // flag. Null until the poller has seen the device.
  radio1Util          Int? // 2.4G channel utilization %
  radio2Util          Int? // 5G channel utilization %
  firmwareOutdated    Boolean @default(false) // verCompareFlag
  recommendedFirmware String? // recommendSoftwareVersion
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ports RuijiePort[]

  @@unique([accountId, cloudSerial])
  @@index([accountId])
  @@map("ruijie_router")
}

// One physical LAN/uplink port of a Ruijie AP/switch, sampled by the worker's
// port poller (per-SN cloud call, adaptive interval). This is the mechanism that
// catches a link SILENTLY renegotiating down (e.g. a gigabit uplink dropping to
// 100M/10M on a bad cable) — invisible to ping/Netwatch, which still read "up".
// The `baseline*` is the known-good speed; `degraded` = currently up but slower.
model RuijiePort {
  id       String       @id @default(cuid())
  routerId String
  router   RuijieRouter @relation(fields: [routerId], references: [id], onDelete: Cascade)

  portName  String // "LAN1", "LAN3/IPTV", "Port 2"
  portIndex Int
  medium    String? // "Copper" | "Fiber" (switches; APs omit it)

  // Current observed state (last poll).
  up        Boolean @default(false)
  speedMbit Int     @default(0) // negotiated Mbit when up; 0 down/unknown
  enabled   Boolean @default(true)

  // Baseline = the healthy speed we expect. Auto-learned as the max ever seen
  // (never lowered automatically — that is exactly the drop we want to catch),
  // or pinned by an admin so a port that was mis-negotiated since day one still
  // alarms against its intended speed.
  baselineMbit   Int     @default(0) // 0 = not learned yet
  baselinePinned Boolean @default(false)

  // Degradation state: up but slower than baseline. `pendingSlow` debounces a
  // one-off renegotiation before we alert; `degradedSince` timestamps the drop.
  degraded      Boolean   @default(false)
  degradedSince DateTime?
  pendingSlow   Int       @default(0)

  // Flap: link bounced (up<->down). Rolling count feeds a "loose cable" alert.
  lastLinkChangeAt DateTime?
  linkDowns        Int       @default(0)

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([routerId, portName])
  @@index([routerId])
  @@map("ruijie_port")
}

// Append-only port timeline: every degradation/recovery/link-flap, for the
// per-port history ("LAN1 dropped to 100M 3x this month") and the weekly
// repeat-offender report. Swept by the retention job like StatusEvent.
model RuijiePortEvent {
  id       String   @id @default(cuid())
  routerId String
  portName String
  kind     String // "degraded" | "recovered" | "link-down" | "link-up"
  fromMbit Int?
  toMbit   Int?
  note     String?
  at       DateTime @default(now())

  @@index([routerId, at])
  @@index([at])
  @@map("ruijie_port_event")
}
